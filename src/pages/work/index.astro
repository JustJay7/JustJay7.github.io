---
import Base from '../../layouts/Base.astro';
import Work from '../../components/Work.astro';
---

<Base title="Work" description="Case studies of AI, data and software projects by Jay Malhotra.">
  <div class="wrap">
    <header class="case-head">
      <a class="back" href="/">Home</a>
      <h1>Work</h1>
      <p class="lede">Each one opens a short case study: the problem, what I built, the results and the limits.</p>
    </header>
    <section style="padding-top:1rem">
      <Work />
    </section>
  </div>

  <script>
    document.querySelectorAll('.plate').forEach((el) => el.classList.add('in'));
  </script>
</Base>
