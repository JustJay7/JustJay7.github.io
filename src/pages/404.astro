---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <div class="wrap">
    <header class="case-head">
      <h1>That page does not exist.</h1>
      <p class="lede">The link may be old. Everything on this site is one click from the home page.</p>
      <div class="actions">
        <a class="btn primary" href="/">Go to the home page</a>
      </div>
    </header>
  </div>
</Base>
