---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Work from '../components/Work.astro';
import TimeMachine from '../components/TimeMachine.astro';
import Marquee from '../components/Marquee.astro';
import { site, experience, education, moreWork } from '../data/site';
---

<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-spot" aria-hidden="true"></div>

      <div class="who">
        <div class="me">
          <span class="ring"><img src="/jay.jpg" alt="Jay Malhotra" width="112" height="112" /></span>
          <span>
            <strong>{site.name}</strong>
            <span class="role">{site.role}, MMA at McGill</span>
          </span>
        </div>
        <span class="pill"><span class="live"></span>Open to internships and full-time roles in Toronto or remote in Canada</span>
      </div>

      <h1>
        <span class="big">I build AI products <em>end to end,</em></span>
        <span class="small">from the <b>model</b> to the <b>app</b> people use.</span>
      </h1>

      <div class="actions">
        <a class="btn primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href="/Jay_Malhotra_Resume.pdf">Resume (PDF)</a>
        <a class="btn" href={site.github}>GitHub</a>
        <a class="btn" href={site.linkedin}>LinkedIn</a>
      </div>

      <Rail />
    </section>

    <section id="work">
      <div class="sec-head">
        <h2>Selected work</h2>
        <p>Six things I built or led. Each one opens a short case study with real footage, the numbers and the limits.</p>
      </div>
      <Work />
    </section>

    <section>
      <div class="sec-head">
        <h2>Try one</h2>
        <p>
          The idea behind AsOf, live. An AI assistant gives two customers the same answer. Whether it is right depends on
          which policy version applied on each customer's date.
        </p>
      </div>
      <TimeMachine />
      <p class="muted" style="margin-top:1rem">
        Drag the date and watch the verdict flip. <a href="/work/asof/">Read the AsOf case study.</a>
      </p>
    </section>

    <section id="experience">
      <div class="two">
        <div>
          <h2>Experience</h2>
          <div class="rows">
            {
              experience.map((e) =>
                e.href ? (
                  <a href={e.href}>
                    <strong>{e.org}</strong>
                    <span class="when mono">{e.when}</span>
                    <span class="sub">{e.role}</span>
                  </a>
                ) : (
                  <div>
                    <strong>{e.org}</strong>
                    <span class="when mono">{e.when}</span>
                    <span class="sub">{e.role}</span>
                  </div>
                ),
              )
            }
          </div>
        </div>
        <div>
          <h2>Education</h2>
          <div class="rows">
            {
              education.map((e) => (
                <div>
                  <strong>{e.org}</strong>
                  <span class="when mono">{e.when}</span>
                  <span class="sub">{e.role}</span>
                </div>
              ))
            }
          </div>
          <h2 style="margin-top:2.5rem">More work</h2>
          <div class="rows">
            {
              moreWork.map((m) =>
                m.href ? (
                  <a href={m.href}>
                    <strong>{m.title}</strong>
                    <span class="sub">{m.text}</span>
                  </a>
                ) : (
                  <div>
                    <strong>{m.title}</strong>
                    <span class="sub">{m.text}</span>
                  </div>
                ),
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="about">
        <h2>From the model to the app.</h2>
        <div class="txt">
          <p>
            I like owning a problem from the model to the interface a person actually uses. In the last year that has
            meant a production platform for universities, three hackathon builds this fall, and a machine learning
            project I led with a team of seven.
          </p>
          <p>
            I grew up in India and did a BCA with an AI specialization at Bennett University. I am now in Canada for
            the Master of Management in Analytics at McGill, which adds the business and data side to the engineering.
          </p>
          <p>
            I am looking for an AI/ML engineering, data engineering or software role, as an internship or full time, in
            Toronto or remote in Canada.
          </p>
        </div>
      </div>
    </section>
  </div>

  <Marquee />

  <div class="wrap">
    <section id="contact" class="contact">
      <h2>Have a role in mind? Let's talk.</h2>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="actions">
        <a class="btn primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn" href="/Jay_Malhotra_Resume.pdf">Resume (PDF)</a>
        <a class="btn" href={site.linkedin}>LinkedIn</a>
        <a class="btn" href={site.github}>GitHub</a>
      </div>
    </section>
  </div>

  <script>
    // Work plates wipe in once as they scroll into view.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    document.querySelectorAll('.plate').forEach((el) => io.observe(el));

    // A soft light follows the pointer across the hero.
    const hero = document.querySelector<HTMLElement>('.hero');
    if (hero && window.matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${e.clientX - r.left}px`);
        hero.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  </script>
</Base>
